    "semantic": {
      "description": "Status colors. Avoids default reds/greens by tuning hue and lightness off Tailwind defaults.",
      "success": {
        "oklch": "oklch(0.75 0.140 145)",
        "hex": "#5cc78c",
        "rationale": "Sage green, hue 145 (between yellow-green and emerald). Distinguishable from generic Tailwind green-500."
      },
      "warning": {
        "oklch": "oklch(0.78 0.108 73)",
        "hex": "#d4a574",
