  "accessibility": {
    "wcag_aa": true,
    "wcag_aaa_partial": true,
    "tested_combinations": [
      { "fg": "#f5f5f5", "bg": "#030508", "ratio": 17.74, "passes": ["AA", "AAA"] },
      { "fg": "#d4a574", "bg": "#030508", "ratio": 9.34,  "passes": ["AA", "AAA"] },
      { "fg": "#ffd9a0", "bg": "#030508", "ratio": 13.49, "passes": ["AA", "AAA"] },
      { "fg": "#e9c47a", "bg": "#030508", "ratio": 10.69, "passes": ["AA", "AAA"] },
      { "fg": "#38bdf8", "bg": "#030508", "ratio": 9.05,  "passes": ["AA", "AAA"] },
      { "fg": "rgba(245,245,245,0.7)", "bg": "#030508", "ratio": 11.20, "passes": ["AA", "AAA"] },
      { "fg": "rgba(245,245,245,0.5)", "bg": "#030508", "ratio": 6.95,  "passes": ["AA", "AAA-large"] }
    ],
    "colorblind_safe": true,
    "colorblind_notes": "Gold + cyan dual accents are distinguishable across all three major colorblind types (deuteranopia, protanopia, tritanopia). The semantic palette uses both hue and lightness to differentiate, not hue alone."
  },
  "usage": {
    "60_30_10_distribution": {
      "60_dominant": ["ink-1000", "ink-950"],
      "30_secondary": ["text-primary (#f5f5f5)", "text-secondary"],
      "10_accent": ["aureate-200", "aureate-300", "aureate-400"]
    },
    "do_not_use": [
      "Pure black (#000000) — use ink-1000 for the cool tint",
      "Pure white (#ffffff) — use text-primary (#f5f5f5) for warmth",
      "Tailwind default colors (slate, gray, amber, sky) — they map close to our scales but break the brand vocabulary"
    ]
  }
}
